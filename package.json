{
  "name": "@hcgstudio/prompt-enhancer",
  "version": "1.2.0",
  "description": "Enhance simple vibe coding prompts into well-structured prompts for Claude Code / Codex",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HCGStudio/prompt-enhancer.git"
  },
  "homepage": "https://github.com/HCGStudio/prompt-enhancer#readme",
  "bugs": {
